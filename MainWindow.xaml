<Window x:Class="תכונת_לומדה_6._11._26.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:תכונת_לומדה_6._11._26"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Lavender">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="ברוכים הבאים" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Grid.Column="1" Grid.ColumnSpan="3"  Foreground="Purple"/>
        <Button x:Name="start" Grid.Row="2" Grid.Column="2" Content="התחל" Height="60" Width="100" FontSize="30" Click="Start"/>

        <Grid x:Name="targil" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="num1" FontSize="30" Grid.Row="1" HorizontalAlignment="Center"/>
            <TextBlock x:Name="peula" FontSize="30" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center"/>
            <TextBlock x:Name="num2" FontSize="30" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center"/>
            <TextBlock Text="=" FontSize="30" Grid.Column="3" Grid.Row="1" HorizontalAlignment="Center"/>
            <TextBox x:Name="ans" FontSize="30" Grid.Column="4" Grid.Row="1" HorizontalAlignment="Center"
                     Height="50" Width="70"/>
            <Button Content="send" FontSize="20" Grid.Column="5" Grid.Row="1" HorizontalAlignment="Center"
                     Height="40" Width="50"/>
        </Grid>
        <TextBlock x:Name="bdika" FontSize="20" Grid.Column="5" Grid.Row="1" HorizontalAlignment="Center" 
                   Visibility="Collapsed"/>

        <TextBlock x:Name="grade" FontSize="30" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="2" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="הציון הוא " Visibility="Collapsed"/>
    </Grid>
</Window>
